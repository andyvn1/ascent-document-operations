# Private notes/context (business docs, AI.md, task config) — never tracked
# (repo is public; this folder holds everything that must stay off GitHub)
ascent-private-files/

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (web app)
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Real customer documents (only test fixtures may be committed)
*.pdf
!tests/fixtures/**/*.pdf

# Local file storage backend — uploaded file content, not source
storage/
